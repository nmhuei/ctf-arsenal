set pagination off
set confirm off
set logging file script/memcmp.log
set logging overwrite on
set logging enabled on
break memcmp
commands
silent
printf "CMP n=%lu a=", $rdx
x/32bx $rdi
printf " b="
x/32bx $rsi
printf "\n"
continue
end
continue
break bcmp
commands
silent
printf "BCMP n=%lu a=", $rdx
x/32bx $rdi
printf " b="
x/32bx $rsi
printf "\n"
continue
end
continue
set pagination off
set confirm off
set logging file script/send_bt.log
set logging overwrite on
set logging enabled on
break send
commands
silent
printf "SEND fd=%d len=%lu\n", $rdi, $rdx
bt 25
continue
end
continue
break writev
commands
silent
printf "WRITEV fd=%d count=%lu\n", $rdi, $rdx
bt 25
continue
end
continue
