import time
load('test_kernel_1d.sage')

# Augmented matrix: coeff_mat and n * I_9
M_aug = Matrix(ZZ, list(coeff_mat.rows()) + list(n * identity_matrix(ZZ, 9)))
HNF = M_aug.hermite_form()
HNF_nonzero = Matrix(ZZ, [r for r in HNF.rows() if vector(r).norm() > 0])

# Duality:
# The lattice of solutions x in Z^9 such that coeff_mat * x = 0 mod n:
# This lattice is generated by n * HNF_nonzero^-T:
HNF_inv = HNF_nonzero.inverse()
L_sol = (n * HNF_inv).transpose()
print("L_sol dimensions:", L_sol.dimensions())
print("L_sol det bit length:", ZZ(L_sol.det()).bit_length())
print("L_sol det // n:", L_sol.det() // n if L_sol.det() % n == 0 else "not div by n")
print("L_sol is integer:", all(x in ZZ for x in L_sol.list()))

L_sol_int = Matrix(ZZ, L_sol)

# Check that Kc_monos is in L_sol_int:
coords_Kc = L_sol_int.solve_left(Kc_monos)
print("Kc_monos in L_sol:", all(x in ZZ for x in coords_Kc))

# Weights:
# monos = [k0, k1, k2, k0^2, k1^2, k2^2, k0*k1, k0*k2, k1*k2]
# k_i is ~ 2^190
# k_i * k_j is ~ 2^380
X = 1 << 192
X2 = 1 << 384
weights = [X2 // X, X2 // X, X2 // X, 1, 1, 1, 1, 1, 1]

W_mat = diagonal_matrix(weights)
L_weighted = L_sol_int * W_mat

print("[*] Running LLL on 9x9 weighted lattice...")
t0 = time.time()
L_red = L_weighted.LLL()
print(f"[+] LLL completed in {time.time() - t0:.3f}s!")

for idx, r in enumerate(L_red.rows()):
    unweighted = [r[i] // weights[i] for i in range(9)]
    norm_bits = vector(QQ, unweighted).norm().n().log(2)
    print(f"Row {idx}: norm bits = {norm_bits:.1f}")
    print(f"  k = ({unweighted[0]}, {unweighted[1]}, {unweighted[2]})")
    print(f"  k0 bits = {abs(unweighted[0]).bit_length()}, k1 bits = {abs(unweighted[1]).bit_length()}, k2 bits = {abs(unweighted[2]).bit_length()}")
    # Check if k0 * k1 == unweighted[6]:
    print(f"  k0^2 == unweighted[3]: {unweighted[0]^2 == unweighted[3]}")
    print(f"  k0*k1 == unweighted[6]: {unweighted[0]*unweighted[1] == unweighted[6]}")
