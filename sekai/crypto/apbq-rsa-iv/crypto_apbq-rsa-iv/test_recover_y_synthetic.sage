load('test_y_congruence.sage')

col0 = vector(ZZ, [T_mat[0, 0], T_mat[1, 0], T_mat[2, 0]])
col1 = vector(ZZ, [T_mat[0, 1], T_mat[1, 1], T_mat[2, 1]])
col2 = vector(ZZ, [T_mat[0, 2], T_mat[1, 2], T_mat[2, 2]])

inv_h0 = pow(int(h[0]), -1, n)
inv_h1 = pow(int(h[1]), -1, n)
inv_h2 = pow(int(h[2]), -1, n)

w0 = vector(ZZ, [(c * inv_h0) % n for c in col0])
w1 = vector(ZZ, [(c * inv_h1) % n for c in col1])
w2 = vector(ZZ, [(c * inv_h2) % n for c in col2])

diff1 = (w1 - w0) % n
diff2 = (w2 - w0) % n

# Construct 3D lattice:
# y * diff1 = 0 mod n
# y * diff2 = 0 mod n
# Matrix rows generate the lattice of y:
# Using kernel_lattice or dual:
# Relations: [diff1, diff2, [n, 0, 0], [0, n, 0], [0, 0, n]]
M = Matrix(ZZ, [
    list(diff1),
    list(diff2),
    [n, 0, 0],
    [0, n, 0],
    [0, 0, n]
])
# The lattice of vectors y such that y * diff1 = 0 mod n and y * diff2 = 0 mod n:
# is the orthogonal/dual lattice mod n:
# We can find it by right_kernel mod n, or using Hermite normal form / dual basis:
# Or directly:
# Any y in Z^3 satisfies diff1[0]*y0 + diff1[1]*y1 + diff1[2]*y2 = k1*n
# diff2[0]*y0 + diff2[1]*y1 + diff2[2]*y2 = k2*n

# A standard way in Sage:
# Define the relation matrix:
R = Matrix(ZZ, [list(diff1), list(diff2)])
# Kernel of R modulo n:
# y * R.T = 0 mod n
# This is the lattice: {y in Z^3 : y * R.T in n Z^2}
# Embed into 5D:
# [ y, (y*R.T)/n ]
# Or dual of the lattice generated by R/n and Z^3:
L = Matrix(ZZ, [
    [diff1[0], diff1[1], diff1[2]],
    [diff2[0], diff2[1], diff2[2]],
    [n, 0, 0],
    [0, n, 0],
    [0, 0, n]
]).right_kernel().basis_matrix()
print("Right kernel dimension:", L.dimensions())
