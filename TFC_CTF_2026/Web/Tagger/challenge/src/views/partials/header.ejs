<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090c18" />
    <title><%= title %> · Tagger</title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/app.js" defer></script>
  </head>
  <body>
    <div class="scanlines" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Tagger home">
        <span class="brand-mark">T</span>
        <span>TAGGER<span class="cursor">_</span></span>
      </a>
      <% if (currentUser) { %>
        <nav class="main-nav" aria-label="Main navigation">
          <a class="<%= path.startsWith('/chat') ? 'active' : '' %>" href="/chat">Chat</a>
          <a class="<%= path === '/discover' ? 'active' : '' %>" href="/discover">Discover</a>
          <a class="<%= path === '/requests' ? 'active' : '' %>" href="/requests">Requests</a>
          <a class="<%= path === '/settings' ? 'active' : '' %>" href="/settings">Settings</a>
        </nav>
        <div class="user-panel">
          <span class="online-dot" aria-hidden="true"></span>
          <span class="username"><%= currentUser.username %></span>
          <form action="/logout" method="post">
            <button class="button button-small button-ghost" type="submit">Log out</button>
          </form>
        </div>
      <% } %>
    </header>
    <main class="page-shell">
      <% if (notice) { %>
        <div class="flash flash-success" role="status"><%= notice %></div>
      <% } %>
      <% if (error) { %>
        <div class="flash flash-error" role="alert"><%= error %></div>
      <% } %>
