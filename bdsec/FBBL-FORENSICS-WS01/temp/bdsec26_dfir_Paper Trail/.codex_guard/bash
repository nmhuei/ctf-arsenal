#!/usr/bin/env bash
set -euo pipefail
cmd="$*"
if [[ "${1:-}" == "-lc" || "${1:-}" == "-c" ]]; then
  cmd="${2:-}"
fi
case "$cmd" in
  *"xargs -P"*|*"parallel"*|*"hashcat"*|*"john"*|*"hydra"*|*"medusa"*|*"ncrack"*|*"sqlmap"*|*"crunch"*|*"cewl"* )
    echo "Blocked: high-risk automated attack command requires explicit user approval." >&2
    exit 126
    ;;
esac
exec /bin/bash "$@"
