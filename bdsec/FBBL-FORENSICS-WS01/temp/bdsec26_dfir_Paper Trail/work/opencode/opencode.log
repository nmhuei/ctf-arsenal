timestamp=2026-07-20T16:57:49.803Z level=INFO run=5abfac96 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport subprocess\nimport json\n\n# Get all DNS response details\nresult = subprocess.run(\n    [\"tshark\", \"-r\", \"/var/captures/archived/network_capture.pcap\", \n     \"-Y\", \"dns.flags.response == 1\",\n     \"-T\", \"fields\", \n     \"-e\", \"frame.number\", \"-e\", \"dns.qry.name\", \"-e\", \"dns.resp.name\",\n     \"-e\", \"dns.txt\", \"-e\", \"dns.a\", \"-e\", \"dns.aaaa\",\n     \"-E\", \"separator=|\", \"-E\", \"quote=d\"],\n    capture_output=True, text=True, timeout=30\n)\n\ndns_lines = result.stdout.strip().split('\\n')\nprint(f\"Total DNS responses: {len(dns_lines)}\")\nfor line in dns_lines:\n    if line.strip():\n        print(line)\nPYEOF" action.permission=* action.action=allow action.pattern=*
