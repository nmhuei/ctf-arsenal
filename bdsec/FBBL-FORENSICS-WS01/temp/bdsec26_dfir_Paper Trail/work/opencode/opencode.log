timestamp=2026-07-20T17:01:47.349Z level=INFO run=5abfac96 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport subprocess\n\n# List all conversations on port 5432 and get the first stream\nresult = subprocess.run(\n    [\"tshark\", \"-r\", \"/var/captures/archived/network_capture.pcap\",\n     \"-Y\", \"tcp.port == 5432\",\n     \"-T\", \"fields\",\n     \"-e\", \"tcp.stream\",\n     \"-e\", \"frame.number\",\n     \"-E\", \"separator=|\"],\n    capture_output=True, text=True, timeout=30\n)\n\n# Get unique streams and their first frame\nstreams = {}\nfor line in result.stdout.strip().split('\\n'):\n    if line.strip():\n        parts = line.strip().strip('\"').split('|')\n        stream_num = int(parts[0])\n        frame_num = int(parts[1])\n        if stream_num not in streams or frame_num < streams[stream_num]:\n            streams[stream_num] = frame_num\n\nfor s in sorted(streams.keys())[:5]:\n    print(f\"Stream {s}: first frame {streams[s]}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
