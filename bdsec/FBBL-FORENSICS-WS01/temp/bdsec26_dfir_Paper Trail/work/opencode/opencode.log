timestamp=2026-07-20T17:01:57.715Z level=INFO run=5abfac96 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport subprocess\n\n# Get the payload from the first PostgreSQL exchange (frames 51-60)\n# Follow stream 4 (which should be a PostgreSQL stream)\nresult = subprocess.run(\n    [\"tshark\", \"-r\", \"/var/captures/archived/network_capture.pcap\",\n     \"-z\", \"follow,tcp,ascii,4\",\n     \"-o\", \"follow.show_all:TRUE\"],\n    capture_output=True, text=True, timeout=30\n)\n\n# Just print the data part (skip the packet headers at the beginning)\nlines = result.stdout.split('\\n')\n# Skip headers, just print data lines\nin_data = False\nfor line in lines:\n    if '-------------' in line:\n        in_data = not in_data\n        continue\n    if in_data:\n        print(line)\nPYEOF" action.permission=* action.action=allow action.pattern=*
