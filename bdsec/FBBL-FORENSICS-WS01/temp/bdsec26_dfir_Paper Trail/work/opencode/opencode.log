timestamp=2026-07-20T17:00:42.941Z level=INFO run=5abfac96 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport subprocess\n\n# Extract TCP stream data for port 5432 conversations\n# Use tshark to get the raw data from these streams\n# First, let's find the TCP streams\nresult = subprocess.run(\n    [\"tshark\", \"-r\", \"/var/captures/archived/network_capture.pcap\",\n     \"-Y\", \"tcp.port == 5432\",\n     \"-T\", \"fields\",\n     \"-e\", \"tcp.stream\",\n     \"-E\", \"separator=|\"],\n    capture_output=True, text=True, timeout=30\n)\n\nstreams = set()\nfor line in result.stdout.strip().split('\\n'):\n    line = line.strip().strip('\"')\n    if line:\n        streams.add(int(line))\n\nprint(f\"TCP streams on port 5432: {sorted(streams)}\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
